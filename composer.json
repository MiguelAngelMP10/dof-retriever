{
  "name": "miguelangelmp10/dof-retriever",
  "description": "PHP scraper for Mexico's DOF exchange rate using DomCrawler",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Miguel Ángel Muñoz Pozos",
      "email": "mmunozpozos@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "MiguelAngelMP10\\DOFRetriever\\": "src/"
    }
  },
  "require": {
    "php": ">=8.0",
    "symfony/dom-crawler": "^6.0",
    "symfony/css-selector": "^6.0",
    "ext-dom": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.1",
    "symfony/var-dumper": "^7.2"
  },
  "scripts": {
    "test": "vendor/bin/phpunit --color=always --progress --verbose"
  }
}
